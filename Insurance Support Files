      "source": [
        "import shap\n",
        "import pandas as pd\n",
        "import numpy as np\n",
        "from xgboost import XGBRegressor\n",
        "from sklearn.model_selection import KFold\n",
        "from sklearn.metrics import mean_squared_error\n",
        "import warnings\n",
        "\n",
        "warnings.filterwarnings(\"ignore\")\n",
        "\n",
        "# Fixed XGBoost parameters\n",
        "params = {\n",
        "    \"objective\": \"reg:tweedie\",\n",
        "    \"tweedie_variance_power\": 1.5,\n",
        "    \"learning_rate\": 0.1,\n",
        "    \"max_depth\": 5,\n",
        "    \"subsample\": 0.8,\n",
        "    \"colsample_bytree\": 0.8,\n",
        "    \"min_child_weight\": 5,\n",
        "    \"n_estimators\": 300,\n",
        "    \"reg_alpha\": 0.1,\n",
        "    \"reg_lambda\": 0.1\n",
        "}\n",
        "\n",
        "kf = KFold(n_splits=5, shuffle=True, random_state=42)\n",
        "results = []\n",
        "\n",
        "# ⚡ Use X_train2 (scaled + dummies)\n",
        "features = X_train2.columns.tolist()\n",
        "\n",
        "while len(features) > 1:\n",
        "    print(f\"Evaluating with {len(features)} features...\")\n",
        "\n",
        "    fold_preds = np.zeros(X_train2.shape[0])\n",
        "\n",
        "    for train_idx, val_idx in kf.split(X_train2):\n",
        "        X_fold_train = X_train2.iloc[train_idx][features]\n",
        "        X_fold_val = X_train2.iloc[val_idx][features]\n",
        "        y_fold_train = y_train.iloc[train_idx]\n",
        "        y_fold_val = y_train.iloc[val_idx]\n",
        "\n",
        "        model = XGBRegressor(**params)\n",
        "        model.fit(X_fold_train, y_fold_train)\n",
        "        fold_preds[val_idx] = model.predict(X_fold_val)\n",
        "\n",
        "    rmse_val = np.sqrt(mean_squared_error(y_train, fold_preds))\n",
        "    results.append((len(features), rmse_val))\n",
        "\n",
        "    # SHAP-based feature importance\n",
        "    model = XGBRegressor(**params)\n",
        "    model.fit(X_train2[features], y_train)\n",
        "\n",
        "    explainer = shap.TreeExplainer(model)\n",
        "    shap_values = explainer.shap_values(X_train2[features])\n",
        "\n",
        "    shap_importance = np.abs(shap_values).mean(axis=0)\n",
        "    feature_importance = pd.Series(shap_importance, index=features).sort_values(ascending=False)\n",
        "\n",
        "    # Drop the least important feature\n",
        "    features = feature_importance.iloc[:-1].index.tolist()\n",
        "\n",
        "# Save Results\n",
        "performance_df = pd.DataFrame(results, columns=[\"n_features\", \"rmse\"])\n",
        "print(performance_df)\n"
      ]
    }
