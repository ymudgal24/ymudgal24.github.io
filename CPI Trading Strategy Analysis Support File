    "def ann_sharpe(r, periods_per_year=252):\n",
    "    r = r.dropna()\n",
    "    if len(r) < 2:\n",
    "        return np.nan\n",
    "    mu = r.mean() * periods_per_year\n",
    "    sig = r.std(ddof=1) * np.sqrt(periods_per_year)\n",
    "    return np.nan if sig == 0 else mu / sig\n",
    "\n",
    "def period_stats(df, ret_col, periods, date_col=\"date\"):\n",
    "    out = []\n",
    "    for name, (start, end) in periods.items():\n",
    "        m = (df[date_col] >= pd.to_datetime(start)) & (df[date_col] <= pd.to_datetime(end))\n",
    "        s = df.loc[m, ret_col]\n",
    "        out.append({\n",
    "            \"Period\": name,\n",
    "            \"Start\": start,\n",
    "            \"End\": end,\n",
    "            \"AnnSharpe\": ann_sharpe(s),\n",
    "            \"AnnMean\": s.mean() * 252,\n",
    "            \"AnnVol\":  s.std(ddof=1) * np.sqrt(252),\n",
    "            \"N\": s.dropna().shape[0]\n",
    "        })\n",
    "    return pd.DataFrame(out)\n",
    "\n",
    "# --- t-day results by subperiod (SPY / QQQ, strategy / naive) ---\n",
    "spy_t      = period_stats(data, \"strat_SPY_t_tc\",       periods)\n",
