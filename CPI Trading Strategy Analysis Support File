    "# 2.2 Merge signals with daily ETF returns\n",
    "\n",
    "\n",
    "# Keep only trade_date + signal\n",
    "signals = (\n",
    "    cpi_df[[\"trade_date\", \"signal\"]]\n",
    "    .rename(columns={\"trade_date\": \"date\"})\n",
    "    .dropna()\n",
    ")\n",
    "\n",
    "\n",
    "data = prices_df.merge(signals, on=\"date\", how=\"left\")\n",
    "\n",
    "# Signal is only active on CPI t+1 dates; all other days = 0\n",
    "data[\"signal\"] = data[\"signal\"].fillna(0.0)\n",
    "\n",
    "# Strategy returns on SPY / QQQ\n",
    "spy_xs = data[\"ret_SPY\"] - data[\"RF\"]\n",
    "qqq_xs = data[\"ret_QQQ\"] - data[\"RF\"]\n",
    "\n",
    "data[\"strat_SPY\"] = data[\"RF\"] + data[\"signal\"] * spy_xs\n",
    "data[\"strat_QQQ\"] = data[\"RF\"] + data[\"signal\"] * qqq_xs\n",
    "\n",
    "data[[\"date\", \"signal\", \"ret_SPY\", \"strat_SPY\", \"ret_QQQ\", \"strat_QQQ\"]].head(10)\n",
    "\n",
    "# ---- Naive alternative strategy: long on all CPI trade days ----\n",
    "# Same event calendar as main strategy (CPI t+1), but no use of surprise sign\n",
    "\n",
    "data[\"signal_naive\"] = 0.0\n",
    "data.loc[data[\"signal\"] != 0, \"signal_naive\"] = 1.0  # long on every CPI event day\n",
    "\n",
    "data[\"strat_SPY_naive\"] = data[\"RF\"] + data[\"signal_naive\"] * spy_xs\n",
    "data[\"strat_QQQ_naive\"] = data[\"RF\"] + data[\"signal_naive\"] * qqq_xs"
   ]
