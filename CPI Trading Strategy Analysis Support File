    "!pip install yfinance pandas_datareader\n",
    "\n",
    "import pandas as pd\n",
    "import yfinance as yf\n",
    "\n",
    "# 1. Download daily prices for SPY and QQQ\n",
    "start = \"2004-01-01\"\n",
    "end   = \"2025-01-01\"\n",
    "\n",
    "spy = yf.download(\"SPY\", start=start, end=end)\n",
    "qqq = yf.download(\"QQQ\", start=start, end=end)\n",
    "\n",
    "# Make sure we have a proper DatetimeIndex\n",
    "spy.index.name = \"Date\"\n",
    "qqq.index.name = \"Date\"\n",
    "\n",
    "# 2. Compute open-to-close returns\n",
    "spy[\"ret_oc\"] = (spy[\"Close\"] - spy[\"Open\"]) / spy[\"Open\"]\n",
    "qqq[\"ret_oc\"] = (qqq[\"Close\"] - qqq[\"Open\"]) / qqq[\"Open\"]\n",
    "\n",
    "print(\"SPY head:\\n\", spy.head(), \"\\n\")\n",
    "print(\"QQQ head:\\n\", qqq.head(), \"\\n\")"
   ]
