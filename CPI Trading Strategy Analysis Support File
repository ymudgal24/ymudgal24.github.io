   "source": [
    "# 1.2 Construct CPI MoM Actual, Expectation, and Surprise\n",
    "\n",
    "# CPI MoM actual (percentage change)\n",
    "cpi_raw[\"cpi_mom_actual\"] = cpi_raw[\"cpi_index\"].pct_change()\n",
    "\n",
    "# CPI expectation proxy = rolling 12-month average of past MoM\n",
    "cpi_raw[\"cpi_mom_consensus\"] = (\n",
    "    cpi_raw[\"cpi_mom_actual\"]\n",
    "    .shift(1)\n",
    "    .rolling(window=12)\n",
    "    .mean()\n",
    ")\n",
    "\n",
    "# CPI MoM Surprise\n",
    "cpi_raw[\"surprise_mom\"] = (\n",
    "    cpi_raw[\"cpi_mom_actual\"] - cpi_raw[\"cpi_mom_consensus\"]\n",
    ")\n",
    "\n",
    "# Clean final CPI dataset\n",
    "cpi_df = (\n",
    "    cpi_raw\n",
    "    .dropna()\n",
    "    .reset_index()\n",
    "    .rename(columns={\"DATE\": \"date\"})\n",
    ")\n",
    "\n",
    "cpi_df[[\"date\", \"cpi_index\", \"cpi_mom_actual\", \"cpi_mom_consensus\", \"surprise_mom\"]].head()\n"
   ]
