    "import numpy as np\n",
    "import pandas as pd\n",
    "import matplotlib.pyplot as plt\n",
    "\n",
    "def ensure_cpi_day_flag(df, date_col=\"date\", signal_col=\"signal\"):\n",
    "    out = df.copy()\n",
    "    out[date_col] = pd.to_datetime(out[date_col], errors=\"coerce\")\n",
    "    sig = pd.to_numeric(out[signal_col], errors=\"coerce\").fillna(0)\n",
    "    out[\"is_cpi_day\"] = (sig != 0).astype(int)\n",
    "    return out\n",
    "\n",
    "def clean_events_df(df, date_col, event_flag_col, ret_cols):\n",
    "    tmp = df.copy()\n",
    "    tmp[date_col] = pd.to_datetime(tmp[date_col], errors=\"coerce\")\n",
    "    tmp = tmp.dropna(subset=[date_col])\n",
    "\n",
    "    flag = pd.to_numeric(tmp[event_flag_col], errors=\"coerce\").fillna(0).astype(int)\n",
    "    tmp = tmp.loc[flag == 1]\n",
    "\n",
    "    for c in ret_cols:\n",
    "        tmp[c] = pd.to_numeric(tmp[c], errors=\"coerce\")\n",
    "\n",
    "    tmp = tmp.sort_values(date_col)\n",
    "    tmp = tmp.drop_duplicates(subset=[date_col], keep=\"first\")\n",
    "    return tmp\n",
    "\n",
    "def plot_event_returns(events_df, date_col, ret_col, title):\n",
    "    d = events_df[[date_col, ret_col]].copy()\n",
    "    d = d.dropna(subset=[ret_col]).sort_values(date_col)\n",
    "\n",
    "    x = d[date_col].to_numpy()\n",
    "    y = d[ret_col].to_numpy(dtype=float)\n",
    "\n",
    "    cum = (1 + pd.Series(y)).cumprod().to_numpy() - 1\n",
    "\n",
    "    plt.figure(figsize=(12, 5))\n",
    "    plt.bar(x, y, width=3, alpha=0.6, label=\"Event return\")\n",
    "    plt.plot(x, cum, lw=2, label=\"Cumulative (event-to-event)\")\n",
    "    plt.axhline(0, lw=0.8)\n",
    "    plt.title(title)\n",
    "    plt.ylabel(\"Return\")\n",
    "    plt.xlabel(\"Date\")\n",
    "    plt.legend()\n",
    "    plt.grid(alpha=0.3)\n",
    "    plt.tight_layout()\n",
    "    plt.show()\n",
    "\n",
