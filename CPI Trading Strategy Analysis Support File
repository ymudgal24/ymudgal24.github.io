    "    spy_strat = performance_stats(sub[\"strat_SPY_t_tc\"])\n",
    "    spy_bh    = performance_stats(sub[\"ret_SPY\"])  # keep your buy&hold definition consistent\n",
    "    qqq_strat = performance_stats(sub[\"strat_QQQ_t_tc\"])\n",
    "    qqq_bh    = performance_stats(sub[\"ret_QQQ\"])\n",
    "    spy_naive = performance_stats(sub[\"strat_SPY_naive_t_tc\"])\n",
    "    qqq_naive = performance_stats(sub[\"strat_QQQ_naive_t_tc\"])\n",
    "\n",
    "    rows_tday.append(pd.concat([pd.Series({\"Period\": label, \"Asset\": \"SPY Strategy (t-day)\"}), spy_strat]))\n",
    "    rows_tday.append(pd.concat([pd.Series({\"Period\": label, \"Asset\": \"SPY CPI-Only Long (t-day)\"}), spy_naive]))\n",
    "    rows_tday.append(pd.concat([pd.Series({\"Period\": label, \"Asset\": \"SPY Buy&Hold\"}), spy_bh]))\n",
    "\n",
    "    rows_tday.append(pd.concat([pd.Series({\"Period\": label, \"Asset\": \"QQQ Strategy (t-day)\"}), qqq_strat]))\n",
    "    rows_tday.append(pd.concat([pd.Series({\"Period\": label, \"Asset\": \"QQQ CPI-Only Long (t-day)\"}), qqq_naive]))\n",
    "    rows_tday.append(pd.concat([pd.Series({\"Period\": label, \"Asset\": \"QQQ Buy&Hold\"}), qqq_bh]))\n",
