   "source": [
    "TRADING_DAYS = 252\n",
    "\n",
    "def performance_stats(ret: pd.Series, freq: int = TRADING_DAYS) -> pd.Series:\n",
    "    ret = ret.dropna()\n",
    "    if ret.empty:\n",
    "        return pd.Series({\n",
    "            \"Ann. Mean\": np.nan,\n",
    "            \"Ann. Vol\": np.nan,\n",
    "            \"Sharpe\": np.nan,\n",
    "            \"Cum. Return\": np.nan,\n",
    "            \"Num Obs\": 0\n",
    "        })\n",
    "\n",
    "    mean_ann = ret.mean() * freq\n",
    "    vol_ann = ret.std(ddof=1) * np.sqrt(freq)\n",
    "    sharpe = mean_ann / vol_ann if vol_ann > 0 else np.nan\n",
    "    cum_ret = (1 + ret).prod() - 1\n",
    "\n",
    "    return pd.Series({\n",
    "        \"Ann. Mean\": mean_ann,\n",
    "        \"Ann. Vol\": vol_ann,\n",
    "        \"Sharpe\": sharpe,\n",
    "        \"Cum. Return\": cum_ret,\n",
    "        \"Num Obs\": len(ret)\n",
    "    })\n"
   ]
