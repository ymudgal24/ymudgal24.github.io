    "# transaction cost",
    "tc = 0.001   # round-trip cost = 10 bps",
    "",
    "# ---- CORRECTED: Turnover only on position ENTRY/EXIT ----",
    "# Calculate when signal changes (entry/exit points)",
    "data[\"signal_change\"] = data[\"signal\"].diff().fillna(data[\"signal\"])",
    "",
    "# Turnover = 1 only when signal changes, 0 otherwise",
    "data[\"turnover\"] = (data[\"signal_change\"] != 0).astype(int)",
    "",
    "print(\"Turnover details:\")",
    "print(f\"Total CPI trading days: {data['turnover'].sum()}\")",
    "print(f\"SPY strategy signal changes: {(data['signal'].diff() != 0).sum()}\")",
    "",
    "# Apply transaction costs ONLY on position changes",
    "data[\"strat_SPY_tc\"] = (",
    "    data[\"strat_SPY\"] - tc * data[\"turnover\"]",
    ")",
    "",
    "data[\"strat_QQQ_tc\"] = (",
    "    data[\"strat_QQQ\"] - tc * data[\"turnover\"]",
    ")",
    "",
    "perf_stats_tc_spy = performance_stats(data[\"strat_SPY_tc\"])",
    "perf_stats_tc_qqq = performance_stats(data[\"strat_QQQ_tc\"])",
    "",
    "print(\"\\nTransaction cost impact (full sample):\")",
    "print(f\"SPY: {perf_stats_tc_spy}\")",
    "print(f\"QQQ: {perf_stats_tc_qqq}\")",
    "",
    "",
    "data[\"year\"] = data[\"date\"].dt.year",
    "",
    "def subset_period(df, start, end):",
    "    return df[",
    "        (df[\"date\"] >= pd.to_datetime(start)) &",
    "        (df[\"date\"] <= pd.to_datetime(end))",
    "    ].copy()",
    "",
    "periods = {",
    "    \"Full Sample\": (\"2004-01-01\", \"2024-12-31\"),",
    "    \"2004\u20132019\":   (\"2004-01-01\", \"2019-12-31\"),",
    "    \"2020\u20132024\":   (\"2020-01-01\", \"2024-12-31\"),",
    "}",
    "",
    "rows_tc = []",
    "",
    "for label, (start, end) in periods.items():",
    "    sub = subset_period(data, start, end)",
    "",
    "    # ===== Strategy with Transaction Cost (CORRECTED) =====",
    "    spy_strat_tc = performance_stats(sub[\"strat_SPY_tc\"])",
    "    qqq_strat_tc = performance_stats(sub[\"strat_QQQ_tc\"])",
    "",
    "    # ===== Buy & Hold (no transaction cost) =====",
    "    spy_bh = performance_stats(sub[\"ret_SPY\"])",
    "    qqq_bh = performance_stats(sub[\"ret_QQQ\"])",
    "",
    "    rows_tc.append(pd.concat([",
    "        pd.Series({\"Period\": label, \"Asset\": \"SPY Strategy (TC)\"}),",
    "        spy_strat_tc",
    "    ]))",
    "",
    "    rows_tc.append(pd.concat([",
    "        pd.Series({\"Period\": label, \"Asset\": \"SPY Buy&Hold\"}),",
