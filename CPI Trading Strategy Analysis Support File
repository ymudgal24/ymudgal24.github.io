    "# 1.4 Map CPI Release Date \u2192 Next Trading Day (t+1)\n",
    "\n",
    "\n",
    "def get_next_trading_date(release_date, trading_dates):\n",
    "    future_dates = trading_dates[trading_dates > release_date]\n",
    "    if len(future_dates) > 0:\n",
    "        return future_dates.min()\n",
    "    return pd.NaT\n",
    "\n",
    "trading_dates = prices_df[\"date\"].values\n",
    "\n",
    "cpi_df[\"trade_date\"] = cpi_df[\"date\"].apply(\n",
    "    lambda d: get_next_trading_date(d, trading_dates)\n",
    ")\n",
    "\n",
    "# Drop CPI observations that cannot be mapped\n",
    "cpi_df = cpi_df.dropna(subset=[\"trade_date\"]).copy()\n",
    "\n",
    "cpi_df[[\"date\", \"trade_date\", \"surprise_mom\"]].head()\n"
   ]
