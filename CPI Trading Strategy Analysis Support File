    "# 1) Ensure everything is datetime\n",
    "macro[\"date\"] = pd.to_datetime(macro[\"date\"])\n",
    "\n",
    "def next_trading_day(release_dates, price_index):\n",
    "    mapped = []\n",
    "    for d in release_dates:\n",
    "        future_dates = price_index[price_index >= d]\n",
    "        if len(future_dates) > 0:\n",
    "            mapped.append(future_dates[0])\n",
    "        else:\n",
    "            mapped.append(pd.NaT)\n",
    "    return pd.to_datetime(mapped)\n",
    "\n",
    "macro[\"trade_date\"] = next_trading_day(macro[\"date\"].values, spy.index)\n",
    "\n",
    "print(\"Macro with trade_date:\\n\", macro.head(), \"\\n\")\n",
    "\n",
    "# 3) Build events table by looping (no merge / join at all)\n",
    "rows = []\n",
    "for _, row in macro.iterrows():\n",
    "    td = row[\"trade_date\"]\n",
    "    if pd.isna(td):\n",
    "        continue\n",
    "    # skip if that trading day is not in our price data\n",
    "    if td not in spy.index or td not in qqq.index:\n",
    "        continue\n",
    "\n",
    "    rows.append({\n",
    "        \"trade_date\": td,\n",
    "        \"announcement_date\": row[\"date\"],\n",
    "        \"series_name\": row[\"series_name\"],\n",
    "        \"spy_ret\": spy.loc[td, \"ret_oc\"],\n",
    "        \"qqq_ret\": qqq.loc[td, \"ret_oc\"],\n",
    "    })\n",
    "\n",
    "events = pd.DataFrame(rows).set_index(\"trade_date\").sort_index()\n",
    "\n",
    "print(\"Events head:\\n\", events.head(), \"\\n\")\n",
    "print(\"Number of macro events aligned to trading days:\", len(events))\n",
    "print(\"Events columns:\", events.columns.tolist())"
   ]
