    "qqq_t      = period_stats(data, \"strat_QQQ_t_tc\",       periods)\n",
    "qqq_t_nv   = period_stats(data, \"strat_QQQ_naive_t_tc\", periods)\n",
    "\n",
    "spy_t[\"Strategy\"]    = \"CPI (t-day)\"\n",
    "spy_t_nv[\"Strategy\"] = \"Naive (t-day)\"\n",
    "qqq_t[\"Strategy\"]    = \"CPI (t-day)\"\n",
    "qqq_t_nv[\"Strategy\"] = \"Naive (t-day)\"\n",
    "\n",
    "spy_table_t = pd.concat([spy_t, spy_t_nv], ignore_index=True)\n",
    "qqq_table_t = pd.concat([qqq_t, qqq_t_nv], ignore_index=True)\n",
