    "# -------------------------\n",
    "# 4.2 Helper function for FF4 regression\n",
    "# -------------------------\n",
    "def ff4_regression(df: pd.DataFrame, ret_col: str, label: str) -> pd.Series:\n",
    "    \"\"\"\n",
    "    Run FF4 regression:\n",
    "    excess_ret_t = alpha + b_m Mkt_RF + b_s SMB + b_h HML + b_mom Mom + eps\n",
    "    \"\"\"\n",
    "    tmp = df.dropna(subset=[ret_col, 'Mkt_RF', 'SMB', 'HML', 'Mom', 'RF']).copy()\n",
    "    if tmp.empty:\n",
    "        return pd.Series({\n",
    "            'Sample': label,\n",
    "            'Alpha (ann)': np.nan,\n",
    "            't(Alpha)': np.nan,\n",
    "            'p(Alpha)': np.nan,\n",
    "            'R2': np.nan,\n",
    "            'N': 0\n",
    "        })\n",
    "\n",
    "    y = tmp[ret_col]  # already excess return column\n",
    "    X = tmp[['Mkt_RF', 'SMB', 'HML', 'Mom']]\n",
    "    X = sm.add_constant(X)\n",
    "\n",
    "    model = sm.OLS(y, X).fit(cov_type='HAC', cov_kwds={'maxlags': 5})\n",
    "\n",
    "    alpha_daily = model.params['const']\n",
    "    alpha_ann = alpha_daily * TRADING_DAYS\n",
    "\n",
    "    alpha_t = model.tvalues['const']\n",
    "    alpha_p = model.pvalues['const']\n",
    "\n",
    "    return pd.Series({\n",
    "        'Sample': label,\n",
    "        'Alpha (ann)': alpha_ann,\n",
    "        't(Alpha)': alpha_t,\n",
    "        'p(Alpha)': alpha_p,\n",
    "        'R2': model.rsquared,\n",
    "        'N': int(model.nobs)\n",
    "    })\n"
   ]
