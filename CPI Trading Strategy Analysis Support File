    "# 2.1 Define trading signal based on CPI MoM surprise\n",
    "\n",
    "def surprise_to_signal(s):\n",
    "    if s > 0:\n",
    "        return -1.0  # positive surprise \u2192 short\n",
    "    elif s < 0:\n",
    "        return 1.0   # negative surprise \u2192 long\n",
    "    else:\n",
    "        return 0.0   # zero surprise \u2192 no position\n",
    "\n",
    "cpi_df[\"signal\"] = cpi_df[\"surprise_mom\"].apply(surprise_to_signal)\n",
    "\n",
    "cpi_df[[\"date\", \"trade_date\", \"cpi_mom_actual\", \"cpi_mom_consensus\", \"surprise_mom\", \"signal\"]].head()\n"
   ]
